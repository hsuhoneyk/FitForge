<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/CyclingTrackFragment">

    <fragment
        android:id="@+id/CyclingTrackFragment"
        android:name="com.example.fitforge.CyclingTrack"
        android:label="Cycling Track Fragment"
        tools:layout="@layout/fragment_track_cycling">
        <action
            android:id="@+id/CTrackToLogs"
            app:destination="@+id/CyclingLogFragment" />
        <action
            android:id="@+id/CTrackToData"
            app:destination="@+id/CyclingDataFragment" />
    </fragment>

    <fragment
        android:id="@+id/CyclingLogFragment"
        android:name="com.example.fitforge.CyclingLogs"
        android:label="Cycling Logs Fragment"
        tools:layout="@layout/fragment_logs_cycling">
        <action
            android:id="@+id/CLogsToTrack"
            app:destination="@+id/CyclingLogFragment" />
        <action
            android:id="@+id/CLogsToData"
            app:destination="@+id/CyclingDataFragment" />
    </fragment>

    <fragment
        android:id="@+id/CyclingDataFragment"
        android:name="com.example.fitforge.CyclingData"
        android:label="Cycling Data Fragment"
        tools:layout="@layout/fragment_data_cycling">
        <action
            android:id="@+id/CDataToTrack"
            app:destination="@+id/CyclingTrackFragment" />
        <action
            android:id="@+id/CDataToLogs"
            app:destination="@+id/CyclingLogFragment" />
    </fragment>

</navigation>